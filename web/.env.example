# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Team invite emails (Resend API — separate from Supabase auth SMTP)
RESEND_API_KEY=
RESEND_FROM_EMAIL=invites@yourdomain.com

# Auth emails (signup confirm, magic link, reset) — configure in Supabase Dashboard, NOT here.
# 1. Resend: create API key + verify sending domain (https://resend.com)
# 2. Supabase → Authentication → SMTP: host smtp.resend.com, port 465, user resend, pass = API key
# 3. Supabase → Authentication → Rate Limits: raise "emails sent" after custom SMTP is enabled
# 4. REQUIRED: Supabase Dashboard → Project Settings → Data API → Exposed schemas → add "core"
#    (Without this, onboarding cannot write accounts/workspaces — PostgREST returns "Invalid schema: core")

# Encryption (32-byte hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=

# OAuth state signing
OAUTH_STATE_SECRET=change-me-long-random-string

# Stripe billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from Product catalog → your product → Pricing → copy Price ID (price_…)
# MUST match STRIPE_SECRET_KEY account and mode: sk_test_ → Test mode ON in Dashboard; sk_live_ → Test mode OFF
STRIPE_PRO_PRICE_ID=price_...
STRIPE_FIRM_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_FIRM_ANNUAL_PRICE_ID=price_...

# Stripe Connect (add-in OAuth) — CLIENT_ID + SECRET_KEY must be from the SAME Stripe account
# Client ID: Dashboard → Settings → Connect → OAuth (ca_…)
# Secret key: Dashboard → Developers → API keys (sk_test_… — platform secret, not restricted key)
# OAuth token exchange uses STRIPE_SECRET_KEY only (not a separate Connect secret)
# STRIPE_SECRET_KEY is for the Connect app and billing — never auto-links user workspaces.
# Users connect via OAuth (GET /api/stripe/connect); they sign in and pick their Stripe account.
STRIPE_CLIENT_ID=ca_...
# Optional — if set, must match exactly: {NEXT_PUBLIC_APP_URL}/api/stripe/callback
# Production example: https://www.silkview.org/api/stripe/callback
# Wrong: http://silkview.org/..., /api/auth/stripe/..., or add-in host (addin.silkview.org)
STRIPE_REDIRECT_URI=http://localhost:4003/api/stripe/callback
# Dev only (default false): allow POST /api/stripe/connect/platform to bind STRIPE_SECRET_KEY without OAuth.
# OAuth callback never auto-links the platform account — users must connect a different Stripe account.
STRIPE_ALLOW_PLATFORM_SELF_CONNECT=false

# Xero OAuth — register redirect URI exactly in https://developer.xero.com/app/manage
# Local dev: http://localhost:4003/api/xero/callback (Next.js dev is HTTP, not HTTPS). Path is /api/xero/callback not /auth/xero/callback.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Optional — if set, must match exactly: {NEXT_PUBLIC_APP_URL}/api/xero/callback
# Production example: https://www.silkview.org/api/xero/callback
# Wrong: /api/auth/xero, /auth/xero/callback, or add-in host
XERO_REDIRECT_URI=http://localhost:4003/api/xero/callback

# App (web API + OAuth callbacks — NOT the Excel add-in host)
# Production: https://www.silkview.org
NEXT_PUBLIC_APP_URL=http://localhost:4003
# Excel add-in host (manifest + sideload URL)
NEXT_PUBLIC_ADDIN_URL=https://localhost:4000
# Microsoft marketplace listing (optional override)
# NEXT_PUBLIC_EXCEL_ADDIN_STORE_URL=https://marketplace.microsoft.com/en-us/product/office/WA200011110?tab=Overview
FRONTEND_URL=https://localhost:4000

# Dev only: auto-confirm email on signup webhook (password login works without inbox)
# Requires Database Webhook on auth.users INSERT → POST /api/auth/signup
SUPABASE_AUTO_CONFIRM_EMAIL=false

# Cron secret for /api/cron/* routes (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=change-me-long-random-string
