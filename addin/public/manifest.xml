<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="TaskPaneApp">
  <Id>6f4b82d9-1c5a-4b3d-9e28-7a1c5d9f3e4b</Id>
  <Version>1.0.0.2</Version>
  <ProviderName>Silkview Connect</ProviderName>
  <DefaultLocale>en-AU</DefaultLocale>
  <DisplayName DefaultValue="Silkview Connect"/>
  <Description DefaultValue="Connect Stripe and Xero to sync financial data with Excel."/>
  <IconUrl DefaultValue="https://addin.silkview.org/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://addin.silkview.org/icon-64.png"/>
  <SupportUrl DefaultValue="https://www.silkview.org/support"/>
  <AppDomains>
    <AppDomain>https://addin.silkview.org</AppDomain>
    <AppDomain>https://www.silkview.org</AppDomain>
    <AppDomain>https://silkview.org</AppDomain>
    <AppDomain>https://connect.stripe.com</AppDomain>
    <AppDomain>https://login.xero.com</AppDomain>
    <AppDomain>https://identity.xero.com</AppDomain>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://addin.silkview.org/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
