{
  "name": "stripesync",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "addin",
    "web",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w addin\" \"npm run dev -w web\"",
    "dev:addin": "npm run dev -w addin",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w addin && npm run build -w web",
    "verify:addin-deploy": "node addin/scripts/verify-deploy.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
